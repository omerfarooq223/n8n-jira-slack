        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"minimax/minimax-m2.5\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Extract issue details from the text and respond ONLY with JSON in this exact format: {\\\"issueType\\\": \\\"Bug or Story or Task\\\", \\\"summary\\\": \\\"brief issue title\\\", \\\"description\\\": \\\"detailed description\\\"}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ $json.body.text }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
