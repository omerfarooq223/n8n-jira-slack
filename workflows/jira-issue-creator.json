      "name": "OpenRouter AI",
      "credentials": {
        "openRouterApi": {
          "id": "wrbVdIHl6qDXHiDA",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.choices[0].message.content;\nconst clean = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(clean);\n\nconst issueTypeMap = {\n  'bug': 'Bug',\n  'story': 'Story', \n  'task': 'Task'\n};\n\nconst issueType = issueTypeMap[parsed.issueType.toLowerCase()] || 'Task';\n\nreturn [{\n  json: {\n    issueType,\n    summary: parsed.summary,\n    description: parsed.description\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "c6053fcf-1b1b-45ba-8957-362911b8d19c",
      "name": "Parse AI Response"
    },
    {
