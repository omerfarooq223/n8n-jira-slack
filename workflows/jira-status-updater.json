      "id": "af785e33-70eb-49da-94c7-dbdb4cf01b28",
      "name": "Get Jira Transitions",
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "ZfR1Rb3VfPNAsRdt",
          "name": "Jira SW Cloud account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const transitions = $input.item.json.transitions;\nconst requestedStatus = $('Parse Slack Command').item.json.requestedStatus.toLowerCase();\nconst issueKey = $('Parse Slack Command').item.json.issueKey;\nconst responseUrl = $('Parse Slack Command').item.json.responseUrl;\n\n// Map common phrases to status names\nconst statusMap = {\n  'todo': 'To Do',\n  'to do': 'To Do',\n  'start': 'In Progress',\n  'in progress': 'In Progress',\n  'review': 'In Review',\n  'in review': 'In Review',\n  'done': 'Done',\n  'close': 'Done',\n  'closed': 'Done',\n  'finish': 'Done',\n  'complete': 'Done'\n};\n\nconst mappedStatus = statusMap[requestedStatus] || requestedStatus;\n\n// Find matching transition\nconst transition = transitions.find(t => \n  t.name.toLowerCase() === mappedStatus.toLowerCase()\n);\n\nif (!transition) {\n  return [{\n    json: {\n      error: true,\n      message: `Status \"${requestedStatus}\" not found. Available: ${transitions.map(t => t.name).join(', ')}`,\n      responseUrl\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    error: false,\n    issueKey,\n    transitionId: transition.id,\n    transitionName: transition.name,\n    responseUrl\n  }\n}];"
      },
