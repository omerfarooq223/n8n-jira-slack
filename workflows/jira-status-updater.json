    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\nconst text = body.text || '';\nconst userId = body.user_id || '';\nconst responseUrl = body.response_url || '';\n\n// Extract issue key and status from command\n// e.g. \"Move JAN-5 to In Progress\"\nconst issueMatch = text.match(/([A-Z]+-\\d+)/i);\nconst issueKey = issueMatch ? issueMatch[1].toUpperCase() : null;\n\n// Extract status after \"to\" or \"as\"\nconst statusMatch = text.match(/(?:to|as)\\s+(.+)/i);\nconst requestedStatus = statusMatch ? statusMatch[1].trim() : null;\n\nif (!issueKey || !requestedStatus) {\n  return [{\n    json: {\n      error: true,\n      message: `Invalid command format. Try: /jira-update Move JAN-5 to In Progress`,\n      userId,\n      responseUrl\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    error: false,\n    issueKey,\n    requestedStatus,\n    userId,\n    responseUrl\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        0
      ],
      "id": "abecafe8-421a-4ab4-bd49-cd34449aa6f5",
      "name": "Parse Slack Command"
    },
    {
      "parameters": {
        "url": "=https://omerfarooq-dev.atlassian.net/rest/api/3/issue/{{ $json.issueKey }}/transitions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
