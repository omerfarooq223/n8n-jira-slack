    {
      "parameters": {
        "jsCode": "const fullResponse = $input.item.json;\nconst issues = fullResponse.issues || [];\n\nconst statusCount = {};\n\nissues.forEach(issue => {\n  const status = issue.fields?.status?.name;\n  if (status) {\n    statusCount[status] = (statusCount[status] || 0) + 1;\n  }\n});\n\nconst total = issues.length;\nconst done = statusCount['Done'] || 0;\nconst completion = total > 0 ? Math.round((done / total) * 100) : 0;\nconst filled = Math.round(completion / 5);\nconst empty = 20 - filled;\nconst progressBar = '█'.repeat(filled) + '░'.repeat(empty);\nconst statusLines = Object.entries(statusCount)\n  .map(([status, count]) => `• ${status}: ${count}`)\n  .join('\\n') || '• No statuses found';\n\nconst message = `📊 *Board Summary (JAN)*\n\n━━━━━━━━━━━━━━━━━━━━\n\n📈 Completion: ${completion}%\n\\`${progressBar}\\`\n\n📊 *Status Breakdown*\n${statusLines}\n- Total Issues: ${total}\n\n━━━━━━━━━━━━━━━━━━━━`;\n\nreturn [{ json: { message, completion, statusCount, total } }];"
      },
